---
import { site } from '../../data/site';

const year = new Date().getFullYear();
const repo = 'https://github.com/Ahrif123/ahrif-portfolio';

const contacts = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, icon: 'mail' },
  { label: 'Phone', value: site.phone, href: `tel:${site.phoneHref}`, icon: 'phone' },
  { label: 'LinkedIn', value: 'Ahrif Hajjie Cruz', href: site.socials.linkedin, icon: 'person', external: true },
  { label: 'GitHub', value: 'Ahrif123', href: site.socials.github, icon: 'code', external: true },
].filter((c) => c.href);
---
<footer class="site-footer" id="contact">
  <div class="container">
    <div class="panel">
      <div class="pitch">
        <p class="status"><span class="dot" aria-hidden="true"></span>Open to QA roles</p>
        <h2>Looking for a <mark>QA tester</mark>?</h2>
        <p class="sub">On-site in Cavite or Metro Manila, or remote. Email is the fastest way to reach me.</p>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a>
          <button class="btn copy-email" type="button" data-copy={site.email}>Copy email</button>
          <span class="sr-only copy-status" role="status" aria-live="polite"></span>
        </div>
        <p class="scribble" aria-hidden="true">let's talk!</p>
      </div>

      <ul class="cards">
        {contacts.map((c) => (
          <li>
            <a
              class="card"
              href={c.href}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener me' : undefined}
            >
              <span class={`icon icon-${c.icon}`} aria-hidden="true">
                {c.icon === 'mail' && <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>}
                {c.icon === 'phone' && <svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>}
                {c.icon === 'person' && <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>}
                {c.icon === 'code' && <svg viewBox="0 0 24 24"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5" /></svg>}
              </span>
              <span class="text">
                <span class="label">{c.label}</span>
                <span class="value">{c.value}</span>
              </span>
              {c.external && <span class="sr-only"> (opens in a new tab)</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="bottom">
      <p>
        © {year} {site.name}. Built with Astro.{' '}
        <a href={`${repo}/actions`}>Tested with Playwright on every push.</a>
      </p>
      <div class="bottom-links">
        <a href={site.resume} download>Resume (PDF)</a>
        <a href="#main">Back to top</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-2xl) var(--space-l);
    scroll-margin-top: 5rem;
  }

  /* ---------- The glowing panel ---------- */
  .panel {
    --c-ink: var(--hero-ink);
    --c-ink-soft: var(--hero-ink-soft);
    --c-line: var(--hero-line);
    --c-canvas: var(--hero-bg);
    --c-surface: rgb(255 255 255 / 0.08);
    --c-pass: var(--hero-pass);
    color: var(--c-ink);

    display: grid;
    gap: var(--space-xl);
    padding: clamp(1.5rem, 0.75rem + 4vw, 4rem);
    border-radius: clamp(18px, 2vw, 28px);
    background:
      radial-gradient(55% 70% at 0% 0%, var(--hero-glow-2), transparent 65%),
      radial-gradient(60% 80% at 100% 100%, var(--hero-glow-1), transparent 65%),
      var(--hero-bg);
    overflow: hidden;
  }
  @media (min-width: 60rem) {
    .panel { grid-template-columns: 1.15fr 1fr; align-items: center; gap: var(--space-2xl); }
  }

  .pitch { position: relative; display: grid; gap: var(--space-m); justify-items: start; }
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--c-pass);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c-pass) 25%, transparent);
    animation: pulse 2.4s ease-in-out infinite;
  }
  h2 { font-size: var(--step-4); line-height: 1.05; }
  .sub { color: var(--c-ink-soft); max-width: 44ch; }

  .actions { display: flex; flex-wrap: wrap; gap: var(--space-s); margin-top: var(--space-xs); }
  .copy-email { cursor: pointer; background: none; color: inherit; font: inherit; font-weight: 600; }

  .scribble {
    font-family: var(--font-hand);
    font-size: var(--step-2);
    color: var(--c-markup);
    transform: rotate(-5deg);
    margin-left: var(--space-xs);
  }
  :global(:root[data-theme='dark']) .scribble { text-shadow: 0 0 10px rgb(255 79 154 / 0.6); }

  /* ---------- Contact cards ---------- */
  .cards { list-style: none; padding: 0; display: grid; gap: var(--space-s); }
  @media (min-width: 36rem) {
    .cards { grid-template-columns: 1fr 1fr; }
  }
  .card {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    height: 100%;
    padding: var(--space-m);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    background: var(--c-surface);
    text-decoration: none;
    transition: transform 0.25s var(--ease-out, ease), border-color 0.25s, background-color 0.25s;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--c-markup);
    background: rgb(255 255 255 / 0.12);
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 12px;
    color: #fff;
  }
  .icon-mail, .icon-person { background: var(--c-sky); }
  .icon-phone, .icon-code { background: var(--c-markup); color: var(--c-on-markup); }
  .icon svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .text { display: grid; min-width: 0; }
  .label { font-size: var(--step--1); color: var(--c-ink-soft); }
  .value { font-weight: 600; overflow-wrap: anywhere; }

  /* ---------- Bottom line ---------- */
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    padding-top: var(--space-l);
    font-size: var(--step--1);
    color: var(--c-ink-soft);
  }
  .bottom p { max-width: none; }
  .bottom-links { display: flex; gap: var(--space-l); }

  @keyframes pulse {
    50% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--c-pass) 10%, transparent); }
  }
</style>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('.copy-email');
  const copyStatus = document.querySelector('.copy-status');

  copyButton?.addEventListener('click', async () => {
    const email = copyButton.dataset.copy ?? '';
    try {
      await navigator.clipboard.writeText(email);
      copyButton.textContent = 'Copied ✓';
      if (copyStatus) copyStatus.textContent = 'Email address copied';
    } catch {
      copyButton.textContent = email; // show it so it can be copied by hand
      if (copyStatus) copyStatus.textContent = `Copy failed. The address is ${email}`;
    }
    setTimeout(() => {
      copyButton.textContent = 'Copy email';
      if (copyStatus) copyStatus.textContent = '';
    }, 2200);
  });
</script>