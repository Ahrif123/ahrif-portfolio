---
import { site } from '../../data/site';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/qa', label: 'QA samples' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && path === href;
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true">AC</span>
      <span>Ahrif Cruz</span>
    </a>

    <nav id="site-nav" aria-label="Main">
      <ul class="pill">
        {links.map((l) => (
          <li>
            <a class="nav-link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
      <a class="resume" href={site.resume} download>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
        Resume
      </a>
    </nav>

    <div class="controls">
      <button class="icon-btn theme-toggle" type="button" aria-label="Switch to dark theme">
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7z" /></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4" />
        </svg>
      </button>
      <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="sr-only">Open menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--c-canvas);
    border-bottom: 1px solid var(--c-line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-height: 4.25rem;
  }

  /* ---------- Brand ---------- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-right: auto;
    font-family: var(--font-display);
    font-weight: 650;
    text-decoration: none;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--c-sky), var(--c-markup));
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    box-shadow: 0 6px 14px -6px color-mix(in srgb, var(--c-markup) 70%, transparent);
    transition: transform 0.3s var(--ease-out, ease);
  }
  .brand:hover .mark { transform: rotate(-8deg) scale(1.06); }

  /* ---------- Links ---------- */
  ul { list-style: none; padding: 0; }
  .nav-link {
    display: block;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    transition: background-color 0.25s, color 0.25s;
  }
  .nav-link:hover { background: var(--c-band); color: var(--c-ink); }
  .nav-link.is-active,
  .nav-link[aria-current='page'] {
    background: var(--c-ink);
    color: var(--c-canvas);
  }

  .resume {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.6rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    background: var(--c-ink);
    color: var(--c-canvas);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.25s, transform 0.2s;
  }
  .resume:hover { background: var(--c-markup); color: #fff; transform: translateY(-1px); }
  .resume svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Round icon buttons ---------- */
  .controls { display: flex; align-items: center; gap: var(--space-xs); }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: 999px;
    color: inherit;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, transform 0.3s;
  }
  .icon-btn:hover { border-color: var(--c-markup); color: var(--c-markup); }
  .icon-btn svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .theme-toggle:active { transform: rotate(-30deg); }
  .icon-sun { display: none; }
  :global(:root[data-theme='dark']) .icon-sun { display: block; }
  :global(:root[data-theme='dark']) .icon-moon { display: none; }

  /* ---------- Phone: menu opens as a floating card ---------- */
  nav {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: var(--gutter);
    right: var(--gutter);
    padding: var(--space-s);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: 18px;
    box-shadow: 0 24px 48px -20px rgb(15 26 58 / 0.45);
  }
  nav.open { display: grid; gap: var(--space-s); }
  .pill { display: grid; gap: 2px; }
  .nav-link { padding: 0.75rem 1rem; }

  /* ---------- Desktop: links in a pill bar ---------- */
  @media (min-width: 48rem) {
    .menu-toggle { display: none; }
    nav {
      display: flex;
      align-items: center;
      gap: var(--space-s);
      position: static;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
    }
    .pill {
      display: flex;
      gap: 2px;
      padding: 4px;
      border: 1px solid var(--c-line);
      border-radius: 999px;
      background: color-mix(in srgb, var(--c-surface) 75%, transparent);
    }
    .nav-link { padding: 0.45rem 0.95rem; }
  }
</style>

<script>
  // ---------- Mobile menu ----------
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  const label = button?.querySelector('.sr-only');

  function setOpen(open: boolean) {
    button?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
    if (label) label.textContent = open ? 'Close menu' : 'Open menu';
  }

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });

  // ---------- Light / dark toggle ----------
  const root = document.documentElement;
  const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const updateThemeLabel = () =>
    themeButton?.setAttribute(
      'aria-label',
      root.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
    );
  updateThemeLabel();
  themeButton?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    updateThemeLabel();
  });

  // ---------- Highlight the section you're reading (homepage only) ----------
  const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav-link[href^="/#"]')];
  if (location.pathname === '/' && sectionLinks.length) {
    const byId = new Map(sectionLinks.map((a) => [a.getAttribute('href')!.slice(2), a]));
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          sectionLinks.forEach((a) => a.classList.remove('is-active'));
          byId.get(entry.target.id)?.classList.add('is-active');
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    byId.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) spy.observe(section);
    });
  }
</script>