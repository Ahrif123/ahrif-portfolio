---
import { experience } from '../../data/experience';
---
<section id="experience" class="experience container" aria-labelledby="experience-title">
  <h2 id="experience-title">Experience</h2>

  <ol class="timeline">
    {experience.map((role) => (
      <li class="role">
        <div class="when">
          <p class="dates">
            <time datetime={role.startIso}>{role.start}</time> to{' '}
            <time datetime={role.endIso}>{role.end}</time>
          </p>
          <p class="duration">{role.duration}</p>
        </div>

        <div class="what">
          <h3>{role.title}</h3>
          <p class="company">{role.company}, {role.location}</p>
          <ul class="points">
            {role.points.map((point) => <li>{point}</li>)}
          </ul>
          <ul class="tools" aria-label="Tools used">
            {role.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .experience {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
    scroll-margin-top: 4rem; /* so the sticky header doesn't cover the heading */
  }

  .timeline { list-style: none; padding: 0; display: grid; }

  /* Phone: one vertical line with a dot per role */
  .role {
    position: relative;
    display: grid;
    gap: var(--space-s);
    padding: 0 0 var(--space-xl) var(--space-l);
    border-left: 2px solid var(--c-line);
  }
  .role:last-child { padding-bottom: 0; }
  .role::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0.35rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--c-canvas);
    border: 2px solid var(--c-ink);
  }

  .dates { font-weight: 600; }
  .duration, .company { color: var(--c-ink-soft); font-size: var(--step--1); }
  .what { display: grid; gap: var(--space-xs); }
  h3 { font-size: var(--step-2); }

  .points {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
    padding-left: 1.1rem;
    max-width: var(--measure);
  }
  .points li::marker { color: var(--c-ink-soft); }

  .tools {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-s);
  }
  .tools li {
    font-size: var(--step--1);
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-s);
    background: var(--c-surface);
  }

  /* Desktop: dates in their own column, the line runs between the columns */
  @media (min-width: 48rem) {
    .role {
      grid-template-columns: 10rem 1fr;
      gap: var(--space-xl);
      padding: 0;
      border-left: 0;
    }
    .role::before { display: none; }
    .when { text-align: right; padding-top: 0.2rem; }
    .what {
      position: relative;
      padding: 0 0 var(--space-2xl) var(--space-xl);
      border-left: 2px solid var(--c-line);
    }
    .role:last-child .what { padding-bottom: 0; }
    .what::before {
      content: '';
      position: absolute;
      left: -7px;
      top: 0.55rem;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--c-canvas);
      border: 2px solid var(--c-ink);
    }
  }
</style>