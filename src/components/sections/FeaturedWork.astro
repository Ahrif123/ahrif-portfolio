---
import { Image } from 'astro:assets';
import museaHome from '../../assets/images/musea-home.png';

const built = [
  'Next.js 16 and TypeScript front end, with light and dark mode',
  'Supabase back end where ratings, XP and moderation rules run inside Postgres, protected by row-level security',
  'Scheduled jobs that rank trending art every 15 minutes',
  'Uploads resized and stripped of GPS data in the browser before they leave the device',
];

const tested = [
  'A test plan and step-by-step test cases in a standard manual-testing format',
  'A bug log with before-and-after screenshots for every fix',
  "Security checks, like confirming one user can't edit another user's artwork",
  'Playwright tests for sign-up, upload and search',
];
---
<section id="work" class="work container" aria-labelledby="work-title">
  <header class="section-head">
    <h2 id="work-title">Featured project</h2>
    <p>The project I'm proudest of, shown from both sides: how I built it and how I tested it.</p>
  </header>

  <article class="feature">
    <div class="shot">
      <div class="frame">
        <div class="frame-bar" aria-hidden="true">musea-eta.vercel.app</div>
        <Image
          src={museaHome}
          alt="MUSÉA homepage showing an artwork feed and calls to share art"
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 60rem) 40rem, 100vw"
          loading="lazy"
        />
      </div>
      <p class="scribble" aria-hidden="true">
        <svg viewBox="0 0 40 30"><path d="M34 26 C20 24 10 16 8 4 M3 10 L8 3 L13 9" /></svg>
        built it, then tried to break it
      </p>
    </div>

    <div class="info">
      <h3><a href="/work/musea">MUSÉA</a></h3>
      <p class="lede">
        An art community where artists post their work, get ratings and
        feedback, and compete in weekly challenges.
      </p>

      <div class="split">
        <div>
          <h4>What I built</h4>
          <ul class="built">{built.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <h4>How I tested it</h4>
          <ul class="tested">{tested.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>

      <div class="cta">
        <a class="btn btn-primary" href="/work/musea">Read the case study</a>
        <a class="btn" href="https://musea-eta.vercel.app" target="_blank" rel="noopener">
          Visit the live site<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
  </article>
</section>

<style>
  .work {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
    scroll-margin-top: 4rem;
  }
  .section-head { display: grid; gap: var(--space-s); }
  .section-head p { color: var(--c-ink-soft); }

  .feature { display: grid; gap: var(--space-xl); }
  @media (min-width: 60rem) {
    .feature { grid-template-columns: 1.25fr 1fr; gap: var(--space-2xl); align-items: start; }
    /* Desktop: the screenshot stays in view while you read the lists beside it */
    .shot { position: sticky; top: 6rem; }
  }

  /* Screenshot in a simple browser frame */
  .frame {
    overflow: hidden;
    background: var(--c-canvas);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    box-shadow: 0 24px 48px -28px rgb(26 34 56 / 0.5);
  }
  .frame-bar {
    padding: var(--space-xs) var(--space-m);
    border-bottom: 1px solid var(--c-line);
    font-size: var(--step--1);
    color: var(--c-ink-soft);
  }
  .frame :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }

  /* Handwritten note under the screenshot */
  .scribble {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    width: fit-content;
    margin: var(--space-s) 0 0 auto;
    font-family: var(--font-hand);
    font-size: var(--step-2);
    line-height: 1;
    color: var(--c-markup);
    transform: rotate(-3deg);
    max-width: none;
  }
  .scribble svg {
    width: 2.2rem;
    height: 1.7rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .info { display: grid; gap: var(--space-l); }
  h3 { font-size: var(--step-4); }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--c-markup); text-decoration-thickness: 3px; }
  .lede { font-size: var(--step-1); color: var(--c-ink-soft); }

  /* Two lists side by side only when there's room (tablets); stacked on phones and in the desktop side column */
  .split { display: grid; gap: var(--space-l); }
  @media (min-width: 36rem) and (max-width: 59.99rem) {
    .split { grid-template-columns: 1fr 1fr; }
  }
  h4 { font-family: var(--font-display); font-size: var(--step-1); margin-bottom: var(--space-xs); }

  .split ul { list-style: none; padding: 0; display: grid; gap: var(--space-s); }
  .split li { position: relative; padding-left: 1.2rem; }
  .split li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }
  .built li::before { background: var(--c-sky); }
  .tested li::before { background: var(--c-markup); } /* same color as the markup layer */

  .cta { display: grid; gap: var(--space-s); }
  @media (min-width: 30rem) {
    .cta { display: flex; flex-wrap: wrap; }
  }
</style>