---
import { education, certifications } from '../../data/credentials';
---
<section class="credentials container" aria-labelledby="credentials-title">
  <h2 id="credentials-title">Education and certifications</h2>

  <div class="cols">
    <div>
      <h3>Education</h3>
      <ul>
        {education.map((e) => (
          <li><span class="title">{e.title}</span><span class="place">{e.place}</span><span class="year">{e.year}</span></li>
        ))}
      </ul>
    </div>
    <div>
      <h3>Certifications and awards</h3>
      <ul>
        {certifications.map((c) => (
          <li><span class="title">{c.title}</span><span class="place">{c.place}</span><span class="year">{c.year}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .credentials { display: grid; gap: var(--space-xl); padding-block: var(--space-2xl); }
  .cols { display: grid; gap: var(--space-xl); }
  @media (min-width: 48rem) {
    .cols { grid-template-columns: 1fr 1.4fr; gap: var(--space-2xl); }
  }
  h3 { font-size: var(--step-0); margin-bottom: var(--space-s); }
  ul { list-style: none; padding: 0; border-top: 1px solid var(--c-line); }
  li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 var(--space-m);
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--c-line);
  }
  .title { font-weight: 600; }
  .place { grid-column: 1; color: var(--c-ink-soft); font-size: var(--step--1); }
  .year { grid-column: 2; grid-row: 1; color: var(--c-ink-soft); font-size: var(--step--1); }
</style>