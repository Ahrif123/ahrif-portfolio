---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import FeaturedWork from '../components/sections/FeaturedWork.astro';
import Experience from '../components/sections/Experience.astro';
import Projects from '../components/sections/Projects.astro';
import Credentials from '../components/sections/Credentials.astro';
---
<BaseLayout>
  <Hero />
  <div class="band"><FeaturedWork /></div>
  <Experience />
  <div class="band">
    <Projects />
    <Credentials />
  </div>
</BaseLayout>

<style>
  /* Two sections sharing a band don't need double spacing between them */
  .band :global(section + section) { padding-top: var(--space-m); }
</style>