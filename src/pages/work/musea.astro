---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BugReport from '../../components/ui/BugReport.astro';

const bugs = (await getCollection('bugs', (b) => b.data.project === 'MUSÉA'))
  .sort((a, b) => a.data.code.localeCompare(b.data.code));

const facts = [
  { label: 'Role', value: 'Design, development and QA' },
  { label: 'Stack', value: 'Next.js 16, React, TypeScript, Tailwind CSS v4, Supabase' },
  { label: 'Hosting', value: 'Vercel, deployed on every push' },
  { label: 'Status', value: 'Live beta' },
];

const highlights = [
  {
    title: 'The rules live in the database',
    body: 'XP, rankings, spam limits and moderation run as Postgres functions and triggers, and row-level security decides who can read or change each row. If someone skips the website and calls the API directly, the same rules still apply.',
  },
  {
    title: 'Uploads protect the artist’s privacy',
    body: 'Phone photos can carry the exact GPS location where they were taken. Before an image leaves the browser, MUSÉA redraws it on a canvas, which drops that hidden data, resizes it and picks out its main color for the card background.',
  },
  {
    title: 'Rankings update on a schedule',
    body: 'Scheduled database jobs recalculate trending art every 15 minutes, publish weekly results every Tuesday, close challenges hourly and clean up overnight, so pages stay fast because nothing is calculated on the fly.',
  },
  {
    title: 'Search forgives typos',
    body: 'Trigram search (pg_trgm) matches artwork, artists and tags even when a word is misspelled, so "watercolr" still finds watercolor pieces.',
  },
];

const approach = [
  { label: 'Scope', value: 'Comments first, since it is where users interact most. Upload, search and sign-in are next.' },
  { label: 'Test types', value: 'Functional, negative, security, UI and responsive (360, 768 and 1440px), and keyboard accessibility' },
  { label: 'Security', value: 'Direct API requests as a second user, to confirm row-level security blocks changes to someone else’s data' },
  { label: 'Documentation', value: 'Requirements, test cases, an RTM and a defect log, in the same format I used at DAI' },
];
---
<BaseLayout
  title="MUSÉA case study"
  description="How Ahrif Hajjie Cruz built MUSÉA, an art community on Next.js and Supabase, and then tested it like a client product: test plan, test cases, security checks and bug reports."
  type="article"
>
  <article class="case container">
    <header class="head">
      <a class="back" href="/#work">Back to selected work</a>
      <h1>MUSÉA</h1>
      <p class="lede">
        An art community where artists post their work, get honest ratings and
        feedback, and compete in weekly challenges. I designed and built it,
        then tested it the way I would test a client's product.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="https://musea-eta.vercel.app" target="_blank" rel="noopener">
          Visit the live site<span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a class="btn" href="/files/MUSEA-Comments-Test-Cases.xlsx" download>Download the test suite (Excel)</a>
      </div>
      <dl class="facts">
        {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </header>

    <section class="block" aria-labelledby="built-title">
      <h2 id="built-title">What I built</h2>
      <div class="highlights">
        {highlights.map((h) => (
          <div class="highlight">
            <h3>{h.title}</h3>
            <p>{h.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="tested-title">
      <h2 id="tested-title">How I tested it</h2>
      <p class="block-intro">
        I treated MUSÉA like a product handed to me by a client: write down what
        it should do, design tests against that, run them, and log what fails.
      </p>
      <dl class="approach">
        {approach.map((a) => <div><dt>{a.label}</dt><dd>{a.value}</dd></div>)}
      </dl>
      <div class="suite">
        <h3>Comments test suite</h3>
        <p>
          21 test cases across 9 requirements: 8 positive, 9 negative, 1 edge
          case and 3 UI checks. Each one has its own tab with steps, expected
          and actual results, and links back to the requirement it covers.
        </p>
        <a href="/files/MUSEA-Comments-Test-Cases.xlsx" download>Download the workbook (.xlsx)</a>
      </div>
    </section>

    <section class="block" id="bugs" aria-labelledby="bugs-title">
      <h2 id="bugs-title">Bugs found</h2>
      <div class="bug-list">
        {bugs.map((bug) => <BugReport bug={bug} />)}
      </div>
    </section>

    <section class="block" aria-labelledby="next-title">
      <h2 id="next-title">What's next</h2>
      <ul class="next">
        <li>Automate the core comment tests in Playwright and run them on every push.</li>
        <li>Extend the suite to uploads, search and sign-in.</li>
        <li>Fix BUG-MUS-001 and retest it at every screen size.</li>
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .case { display: grid; gap: var(--space-2xl); padding-block: var(--space-2xl); }

  .head { display: grid; gap: var(--space-l); }
  .back { font-size: var(--step--1); color: var(--c-ink-soft); }
  .lede { font-size: var(--step-1); color: var(--c-ink-soft); max-width: 60ch; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-s); }

  .facts, .approach {
    display: grid;
    gap: var(--space-m) var(--space-xl);
    padding-block: var(--space-l);
    border-block: 1px solid var(--c-line);
  }
  .facts { grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  dt { font-size: var(--step--1); color: var(--c-ink-soft); }
  dd { margin: 0; font-weight: 600; }

  .block { display: grid; gap: var(--space-l); scroll-margin-top: 5rem; }
  .block-intro { color: var(--c-ink-soft); }

  .highlights { display: grid; gap: var(--space-xl); }
  @media (min-width: 48rem) {
    .highlights { grid-template-columns: 1fr 1fr; gap: var(--space-xl) var(--space-2xl); }
  }
  .highlight h3 { font-size: var(--step-1); margin-bottom: var(--space-xs); }
  .highlight p { color: var(--c-ink-soft); }

  .approach div { display: grid; gap: var(--space-2xs); }
  @media (min-width: 48rem) {
    .approach div { grid-template-columns: 11rem 1fr; gap: var(--space-l); }
  }
  .approach dd { font-weight: 400; }

  .suite {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-l);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-left: 3px solid var(--c-markup);
    border-radius: var(--radius-s);
  }
  .suite h3 { font-size: var(--step-1); }
  .suite p { color: var(--c-ink-soft); }
  .suite a { font-weight: 600; }

  .bug-list { display: grid; gap: var(--space-l); }
  .next { padding-left: 1.2rem; display: grid; gap: var(--space-xs); }
</style>